# both pipelines keep their own .env; neither may be committed
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# service account private keys - never commit
secrets/
**/secrets/

# Postman environments carry live Keycloak client_secrets. This rule also
# exists in bluedot_fetch/.gitignore; it is repeated here deliberately, so
# deleting that nested file cannot expose them.
*.postman_environment.json
**/*.postman_environment.json

.venv/
__pycache__/
**/__pycache__/
*.pyc

# generated CSVs and caches
**/data/*.csv
**/*_cache.json

# Documentation generator and its output. Not pipeline: it reads the live
# schema and the source AST to describe columns, and nothing imports it.
# The generated files go too - keeping the output without the generator
# leaves docs nobody can refresh.
**/describe_columns.py
**/docs/columns.md
**/docs/column_comments.sql

# The pause list. set_pause_status.py reads it, so keep it on disk.
/operation_rozgar_jobs_final.xlsx
