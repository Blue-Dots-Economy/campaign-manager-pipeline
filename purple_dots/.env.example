# Postgres. Purple Dots moved off Supabase on 7 Oct 2026; docker-compose.yml
# in this folder brings up the database this points at.
#
#   docker compose up -d
#   python init_db.py          # creates the tables, once
#
# Port 5433, not 5432, so it cannot collide with another Postgres already
# running - a collision there is silent, and writes land in the wrong place.
# If 5433 is taken too, set PD_DB_PORT and use the same port in DATABASE_URL.
POSTGRES_PASSWORD=<choose one>
PD_DB_PORT=5433
DATABASE_URL=postgresql://purple:<the same one>@localhost:5433/purple

# The database DATABASE_URL must point at. The run refuses to start if it
# connects somewhere else (a URL pasted from the wrong environment). Leave
# empty to skip the check.
PD_EXPECTED_DATABASE=purple

# Raya API key for the account that holds the Purple Dots calls.
#
# The key the Blue Dots pipeline uses does NOT see them: in that account the
# 11 Purple Dots agents hold 308 calls and no batches, and the Day1 sheet's
# call_id is a batch contact_id. If Purple Dots production runs on its own
# Raya account, this is that account's key.
RAYA_API_KEY=

# ---------------------------------------------------------------------------
# S3 dump (fetch_s3.py / load_s3.py) - the PLATFORM data, not the calls.
#
# Nothing here is an AWS credential. The campaign manager's own API hands out
# short-lived pre-signed S3 URLs; this is how you authenticate to IT.
#
# CLIENT_ID / CLIENT_SECRET must belong to a SERVICE ACCOUNT, not a person.
# The dump route rejects a coordinator or user token with 403
# NOT_SYSTEM_CLIENT. Ask whoever runs the Purple Dots campaign manager
# deployment - these are not the Blue Dots values.
# All five are required for the platform stage; it is skipped if any is unset.
# REALM has no default - it differs per environment.
BASE_URL=
KEYCLOAK_URL=
REALM=
CLIENT_ID=campaign-manager
CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Known test batches. Every dialled batch is loaded either way; this only
# decides whether its rows carry test_flag = true, which keeps them out of
# the reporting.
#
# Set once and rarely touched. A new CAMPAIGN needs no edit here - it loads
# clean and counts immediately, which is the point: a config step before new
# data counts is a step that gets forgotten. Add a batch here only when it
# turns out to be a trial, then:
#     update purple_dots_calls set test_flag = true where batch_id = '<id>';
PD_TEST_BATCHES=1852,2042,2044,2100,2988,2991,2992

# ---------------------------------------------------------------------------
# Per-deployment overrides. All optional - the defaults in load_purple.py are
# this deployment's, and a second environment supplies its own here rather
# than needing a different build.
#
# PD_INBOUND_AGENTS   id:label pairs for the bots that answer calls
# PD_TEST_PHONES      numbers the team tests from; their calls get test_flag
# RAYA_BASE_URL       defaults to https://v1.getraya.app
PD_INBOUND_AGENTS=
PD_TEST_PHONES=
RAYA_BASE_URL=
PD_AGENTS=
PD_EXCLUDED_AGENTS=
PD_REFRESH_DAYS=3
PD_CONNECT_TIMEOUT=10
PD_STATEMENT_TIMEOUT_MS=300000
