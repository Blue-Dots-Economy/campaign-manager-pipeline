# Copy to .env and fill in the real values, then: python fetchdata.py
# .env is gitignored — never commit the secret.

# Campaign Manager API base URL (host serving /v1/campaign/dump)
BASE_URL=https://campaign.example.org

# Keycloak base URL (host serving /realms/{REALM}/protocol/openid-connect/token)
KEYCLOAK_URL=https://auth.example.org

REALM=campaign
CLIENT_ID=campaign-manager
CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET

# Where the three .jsonl files land (optional; default ./dumps)
OUT_DIR=dumps

# Supabase Postgres URI, for push_to_supabase.py
# Dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the SESSION pooler (port 5432). The transaction pooler (6543) does not
# support the prepared statements psycopg2 issues.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
